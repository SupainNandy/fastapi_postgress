# Application Settings
PROJECT_NAME="FastAPI PostgreSQL App"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=fastapi_db

# SQLAlchemy Database URL (using psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password_here@localhost:5432/fastapi_db

# Security / JWT (For future auth implementation)
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
